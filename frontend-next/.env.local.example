# Local development configuration for the Safety InSite frontend.
#
# §275 added this file because there was no tracked reference for local configuration, and
# the untracked .env.local on the development machine had drifted to a backend port with
# nothing listening on it — the documented developer path did not work out of the box and
# nothing existed to compare it against.
#
# Copy to .env.local and adjust. .env.local is gitignored.

# The backend. `npm run dev` in ../backend listens on 4000.
# Start the BACKEND FIRST: `next dev` will take 4000 for itself if 3000 is busy and 4000 is free.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# DEVELOPMENT BYPASSES. Both stay false. §277 made this the normal local configuration, not
# just the validation one.
#
# `NEXT_PUBLIC_DISABLE_AUTH=true` short-circuits the session guard and
# `NEXT_PUBLIC_DEV_FORCE_PRO=true` grants Pro entitlement locally. They make day-to-day UI
# work marginally faster, and they make everything you see a measurement of the bypass
# rather than of the product — §275 and §276 both ran with them false, against the real
# login and the real entitlement guard, and §276 found defects that only appear there.
NEXT_PUBLIC_DISABLE_AUTH=false
NEXT_PUBLIC_DEV_FORCE_PRO=false

# NO CREDENTIALS BELONG IN THIS FILE. It is tracked. The local `.env.local` you copy it to
# is gitignored and may hold machine-local values (a Vercel OIDC token, for instance); those
# stay there and are never mirrored here, never quoted in evidence and never committed.
