 and safe operation and maintenance (1910.303(g)(1)); live parts of electric equipment operating at 50 volts or more must be guarded against accidental contact by approved cabinets or other approved enclosures, or by the other means that paragraph allows (1910.303(g)(2)(i)); and entrances to rooms and other guarded locations containing exposed live parts must be marked with conspicuous warning signs forbidding unqualified persons to enter (1910.303(g)(2)(iii)). Installations over 600 volts, nominal, are addressed separately at 1910.303(h).","jurisdictionProvenance":"USER_CONFIRMED"}],"observationFragment":"an extension cord feeding the shop light has damaged insulation","possibleOverlapWith":[],"requiresHumanReview":false},"finalizedByUserId":"4961fa69-9d06-4797-b562-6cdd5be2fe46","knowledgeReleaseId":null,"selectedAnalysisId":"50a0f06b-03d8-427b-8ba5-fc0666b4ff8b","reviewerDisposition":"single","originatingAnalysisId":"50a0f06b-03d8-427b-8ba5-fc0666b4ff8b"}],"evidenceSource":"direct_observation"}],"correctiveActions":[{"id":"4078a688-855f-4bbe-804f-02a99d62d0ca","title":"Control Electrical Exposure","siteId":null,"source":"hazlenz_finding_scoped","dueDate":null,"category":null,"reportId":null,"tenantId":"default","createdAt":"2026-08-21T14:12:22.234Z","displayId":null,"findingId":"2560b4c1-a635-42b4-a173-591afbafb141","updatedAt":"2026-08-21T14:12:22.234Z","statusCode":"open","verifiedAt":null,"description":"Immediate: Immediate hazard control required to prevent contact/exposure to Electrical hazard.\nPermanent: Address systemic factors to prevent recurrence.\nVerification: Confirm the hazard control effectively removes the exposure.","ownerUserId":null,"closureNotes":null,"inspectionId":"fbe23841-871c-40ab-b61c-68adaec7e50b","priorityCode":"urgent","assignedToName":null,"organizationId":null,"assignedToUserId":null,"classificationId":null,"verifiedByUserId":null,"originalSuggestion":null}],"knowledgeProvenance":{"findingCount":1,"knowledgeReleaseIds":[],"findings