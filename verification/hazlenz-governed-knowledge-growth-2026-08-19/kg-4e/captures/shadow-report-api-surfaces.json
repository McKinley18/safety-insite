re.","exposurePathways":["electrical energy transfer pathway"],"workerInterfaces":["electrical contact interface"],"exposureAmplifiers":["Maintenance state may bypass normal operational safeguards.","Uncontrolled energy conditions may amplify injury severity."],"exposureComplexity":"low"},"multiHazardDecomposition":{"hazards":[{"domainId":"lockout_tagout","hazardId":"haz-1","mechanism":"hazardous energy control failure","confidence":0.75,"evidenceGaps":["Confirm all hazardous energy sources and isolation/zero-energy verification."],"hazardFamily":"lockout_tagout","conditionState":"ACTIVE","correctionStatus":"not_stated","currentCondition":"Current exposure remains described.","temporalEvidence":[],"reviewerQuestions":["Were all energy sources isolated and verified before or during servicing?"],"supportingSignals":["servicing/intervention","hazardous energy source","energy control failure"],"standardCandidates":[{"title":"The control of hazardous energy (lockout/tagout)","family":"OSHA General Industry hazardous energy control","status":"SUPPORTED","citation":"29 CFR 1910.147","sourceKey":"osha-ecfr-1910","confidence":0.96,"sourceName":"OSHA 29 CFR 1910 General Industry Standards","sourceType":"regulation","explanation":"Supported by submitted evidence for OSHA General Industry hazardous energy control; qualified review remains required.","corpusBacked":false,"applicability":"direct","backingStatus":"UNAPPROVED_CONTENT","contentDisclosure":"HAZLENZ_AUTHORED","missingPredicates":[],"plainLanguageSummary":"Before any employee performs servicing or maintenance on a machine or equipment where unexpected energizing, start up, or release of stored energy could occur and cause injury, the employer must establish an energy control program consisting of energy control procedures, employee training and periodic inspections, and the machine or equipment must be isolated from its energy source and rendered inoperative (29 CFR 1910.147(c)(1)). Where an energy isolating device is 