is unclear.","decisionSummary":"Noise Exposure should be reviewed by a qualified supervisor.","auditReadySummary":"Noise Exposure should be reviewed by a qualified supervisor. Dominant energy source: undetermined. Top uncertainty: Exposure distance or interaction with the hazard is unclear. No top standard selected.","stopWorkRecommended":false,"strongestCausalFactor":"Dominant energy source: undetermined.","immediateActionRecommended":true,"supervisorReviewRecommended":true},"followUpQuestions":[],"informationNeeded":[],"regulatoryContext":{"basis":[],"value":"osha-construction","source":"request","provenance":"USER_CONFIRMED"},"standardDecisions":[{"title":"Respirable crystalline silica","source":"final_predicate_standard_decision_bridge | OSHA 29 CFR 1926 Construction Standards","status":"applicable_after_human_review","citation":"29 CFR 1926.1153","rationale":"The citation is advisory and must be confirmed against the facts, jurisdiction, and authoritative text by a qualified reviewer.","sourceKey":"osha-ecfr-1926","corpusBacked":false,"standardText":"For each employee engaged in a task identified on Table 1 of 29 CFR 1926.1153, the employer must fully and properly implement the engineering controls, work practices and respiratory protection that Table 1 specifies for that task, unless the employer instead assesses and limits exposure under 1926.1153(d) (1926.1153(c)(1)). For stationary masonry saws (Table 1 entry (i)) and for handheld power saws of any blade diameter (Table 1 entry (ii)), Table 1 requires a saw equipped with an integrated water delivery system that continuously feeds water to the blade, operated and maintained in accordance with the manufacturer's instructions to minimize dust emissions; the handheld entry additionally requires respiratory protection with an assigned protection factor of 10 when used indoors or in an enclosed area, and for more than four hours per shift outdoors. Where a task is not listed on Table 1, or where the employer does not fully and properly implement the Table 1 controls, the employer must instead ensure no employee is exposed above the permissible exposure limit of 50 micrograms per cubic metre of respirable crystalline silica as an 8-hour time-weighted average, and must assess exposures accordingly (1926.1153(d)(1)-(2)).","backingStatus":"UNAPPROVED_CONTENT","contentDisclosure":"HAZLENZ_AUTHORED","applicabilityStatus":"probable"}],"trendIntelligence":{"hotspotArea":null,"recommendation":"No recurring trend detected from provided prior findings.","recurrenceRisk":"low","trendDirection":"not_established","highRiskRepeatCount":0,"relatedFindingCount":0,"escalationRecommended":false,"repeatedLocationCount":0,"similarFindingsTimeline":[],"controlFailureIndicators":[],"recentRelatedFindingCount":0,"repeatedClassificationCount":0},"workspaceLearning":{"workspaceId":"default","recommendedUse":"Use workspace learning as supporting intelligence only; do not override regulatory requirements or qualified human review.","learningSignals":[],"learningSummary":"Workspace-specific learning is limited for this hazard type.","learningMaturity":"limited_signal","repeatedSimilarFindingCount":0,"acceptedStandardFeedbackCount":0,"ineffectiveActionOutcomeCount":0,"rejectedStandardFeedbackCount":0},"aiEvidenceContract":{"inputsUsed":["hazard_observation_text"],"advisoryOnly":true,"missingInputs":["specific_location","supporting_photo_or_evidence_note"],"reviewTriggers":["qualified_review_required"],"unsupportedClaims":[],"standardsSourcesUsed":[],"doesNotCreateCitation":true,"doesNotDeclareViolation":true,"requiresQualifiedReview":true,"canFinalizeWithoutHumanReview":false},"commonConsequences":["hearing loss","tinnitus","communication interference"],"domainIntelligence":{"loto":null,"hazcomGhs":null,"trenching":null,"electrical":null,"confinedSpace":null,"liftingRigging":null,"mobileEquipment":null},"evidenceConfidence":{"basis":"submitted evidence facts, provenance, unknowns, and contradictions","s