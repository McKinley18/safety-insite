:["cord"],"standardCandidates":[{"title":"Electrical - general requirements","family":"OSHA General Industry live electrical parts","status":"SUPPORTED","citation":"29 CFR 1910.303","sourceKey":"osha-ecfr-1910","confidence":0.96,"sourceName":"OSHA 29 CFR 1910 General Industry Standards","sourceType":"regulation","explanation":"Supported by submitted evidence for OSHA General Industry live electrical parts; qualified review remains required.","corpusBacked":false,"applicability":"direct","backingStatus":"UNAPPROVED_CONTENT","contentDisclosure":"HAZLENZ_AUTHORED","missingPredicates":[],"plainLanguageSummary":"Section 1910.303 sets OSHA's general requirements for electric equipment and installations in general industry. Electric equipment must be free from recognized hazards that are likely to cause death or serious physical harm to employees (29 CFR 1910.303(b)(1)), and listed or labeled equipment must be installed and used in accordance with any instructions included in the listing or labeling (1910.303(b)(2)). For equipment operating at 600 volts, nominal, or less to ground: sufficient access and working space must be provided and maintained about all electric equipment to permit ready and safe operation and maintenance (1910.303(g)(1)); live parts of electric equipment operating at 50 volts or more must be guarded against accidental contact by approved cabinets or other approved enclosures, or by the other means that paragraph allows (1910.303(g)(2)(i)); and entrances to rooms and other guarded locations containing exposed live parts must be marked with conspicuous warning signs forbidding unqualified persons to enter (1910.303(g)(2)(iii)). Installations over 600 volts, nominal, are addressed separately at 1910.303(h).","jurisdictionProvenance":"USER_CONFIRMED"}],"observationFragment":"an extension cord feeding the shop light has damaged insulation","possibleOverlapWith":[],"requiresHumanReview":false},"finalizedByUserId":"4961fa69-9d06-4797-b562-6cdd5be2fe46","kno