te risk dynamics.","interactionSeverity":"MODERATE"},"decisionExplainability":{"keyEvidence":["Initiating condition requires confirmation. → Exposure pathway requires confirmation. → Active energy could transfer to a worker through contact, motion, electricity, pressure, or gravity. → Control failure mechanism requires confirmation. → Shock, arc flash, burn, or electrocution exposure.","Applicable standards were identified.","1 applicable standard suggestion(s) identified."],"uncertainty":["employee exposure is not clearly described.","exposure distance or interaction with the hazard is unclear.","close match between electrical and lockout / stored energy.","worker exposure is not explicitly described.","shutdown or isolation should remain in place until effective controls are verified."],"riskStatement":"Risk is rated High.","decisionSummary":"Electrical was selected based on hazard signals, context, risk indicators, and standards alignment.","controlStatement":"Durable controls are represented in the recommendation set.","escalationFactors":["Supervisor review recommended by confidence intelligence.","Risk engine recommends shutdown or isolation.","Control intelligence recommends verification before closure."],"standardsStatement":"Top standards were selected from curated HazLenz AI mappings and CFR-backed matching where available.","confidenceStatement":"Overall confidence is 38%.","supervisorReviewRecommended":true},"candidateStandardFamily":"machine_guarding","citationLevelCandidates":[{"id":"review-osha-1910-147-loto","title":"Control of Hazardous Energy (Lockout/Tagout)","agency":"OSHA","citation":"29 CFR 1910.147","sourceId":"osha-1910-147-loto","confidence":0.38,"sourceTrace":["Governed by SourceGovernanceService"],"jurisdiction":"osha_general_industry","authorityTier":"primary_regulation","industryScope":["manufacturing"],"approvalStatus":"approved","prohibitedUses":[],"missingEvidence":[],"requiredEvidence":["LOTO status","energy isolation verification"],