 controls the hazard and the plug is under the exclusive control of the employee performing the work (1910.147(a)(2)(iii)(A)). This standard does not cover construction or agriculture employment (1910.147(a)(1)(ii)(A)).","jurisdictionProvenance":"USER_CONFIRMED"}],"observationFragment":"a maintenance technician is servicing the conveyor while it is still energized and no lock is applied.","possibleOverlapWith":[],"requiresHumanReview":true},"advisoryBoundary":"HazLenz AI multi-hazard decomposition is advisory only.","reviewerQuestions":[],"originalObservation":"a maintenance technician is servicing the conveyor while it is still energized and no lock is applied.","decompositionConfidence":0.9},"reasoningSourceHierarchy":{"primaryBasis":["HazLenz AI governed classifier and reasoning brain","approved knowledge and source governance","regulatory scope filtering","standards applicability service","scenario, equipment, task, mechanism, and evidence reasoning"],"secondaryReferenceOnly":["prior saved findings","workspace learning","site memory","trend intelligence","correlation intelligence","reviewer feedback history"],"prohibitedHistoricalInfluence":["prior findings cannot create a standard match by themselves","prior findings cannot override approved knowledge or source governance","prior findings cannot remove high-risk review requirements","prior findings cannot finalize compliance or violation decisions"]},"standardFamilyCandidates":[{"id":"candidate-machine-guarding","title":"Advisory Machine Guarding Standards Review","evidenceGaps":["access control","energy state"],"whyItMayApply":"Review mapping for potential hazard.","confidenceBand":"medium","reasoningNotes":["Review for advisory guarding standards."],"candidateFamily":"machine_guarding","evidenceRequired":["guard status","LOTO verification"],"factsStillMissing":[],"advisoryGuardrails":{"advisoryOnly":true,"doesNotDeclareViolation":true,"requiresQualifiedReview":true},"confidenceBoosters":["observation of movin