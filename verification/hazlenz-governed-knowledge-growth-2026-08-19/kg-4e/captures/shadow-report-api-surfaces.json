"Possible","overallRisk":"High","provisional":false,"existingControls":[],"reviewerConfirmed":false,"potentialConsequence":"Confirm during qualified review.","reviewerOverrideReasonRequired":true},"contractVersion":"guided-finding-v1","primaryStandard":{"title":"The control of hazardous energy (lockout/tagout)","agency":"Federal","citation":"29 CFR 1910.147","confidence":0.96,"whyOffered":"HazLenz found submitted evidence supporting general-industry jurisdiction, servicing or maintenance activity, hazardous energy present or capable, energy not isolated and locked.","sourceStatus":"provisional-versioned-regulation","applicability":"direct","backingNotice":null,"backingStatus":"UNAPPROVED_CONTENT","sourceRelease":{"bundle":"hazlenz-offline-federal-core","version":"2026-07-29.1","authority":"regulation"},"confidenceLabel":"High","evidenceMissing":[],"evidenceSupporting":["general-industry jurisdiction","servicing or maintenance activity","hazardous energy present or capable","energy not isolated and locked"],"confidenceLimitReason":"The regulatory text shown for this standard has not completed source review. This does not affect how HazLenz assessed applicability.","contradictoryEvidence":[],"simplifiedRequirement":"Before any employee performs servicing or maintenance on a machine or equipment where unexpected energizing, start up, or release of stored energy could occur and cause injury, the employer must establish an energy control program consisting of energy control procedures, employee training and periodic inspections, and the machine or equipment must be isolated from its energy source and rendered inoperative (29 CFR 1910.147(c)(1)). Where an energy isolating device is capable of being locked out, the program must use lockout unless the employer can demonstrate that a tagout system provides full employee protection as set out in 1910.147(c)(3); where the device cannot be locked out, a tagout system must be used (1910.147(c)(2)). The standard covers servicing and maintenance, not normal production operations: work during normal production is covered only if an employee must remove or bypass a guard or other safety device, or must place part of the body into the point of operation or an associated danger zone (1910.147(a)(2)(ii)). Minor tool changes and adjustments and other minor servicing activities that are routine, repetitive and integral to production are excepted when performed under alternative measures providing effective protection (Note to 1910.147(a)(2)(ii)), and work on cord-and-plug connected equipment is excepted where unplugging controls the hazard and the plug is under the exclusive control of the employee performing the work (1910.147(a)(2)(iii)(A)). This standard does not cover construction or agriculture employment (1910.147(a)(1)(ii)(A))."},"correctiveAction":{"urgency":"Urgent","rationale":"Actions are advisory and tied to the OSHA General Industry hazardous energy control evidence and proposed risk.","immediateAction":"Pause affected work and restrict access around the exposed unknown until guarding and electrical exposure controls are reviewed.","responsibleRole":"Qualified responsible person","suggestedDueDate":null,"verificationStep":"Perform a formal inspection and functional verification by a competent person before removing interim controls or resuming normal operations.","hierarchyPreference":["elimination","substitution","engineering","administrative","PPE"],"permanentCorrection":"Install permanent, secure guarding over the exposed unknown to completely eliminate the electrical shock hazard."},"findingCandidates":[{"family":"OSHA General Industry hazardous energy control","citation":"29 CFR 1910.147","applicability":"direct","evidenceFactIds":["fact-1","fact-2","fact-3","fact-4"]}],"multiHazardReview":{"instruction":"Split materially distinct hazard mechanisms into separate findings; merge duplicate obligations.","requiresSplitReview":false},"observedCondition":"A maintenance technician is se