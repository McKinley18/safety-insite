# DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sentinel_user
DB_PASSWORD=password123
DB_NAME=sentinel_dev

# SECURITY
JWT_SECRET=SUPER_SECRET_KEY_FOR_PRODUCTION_ONLY
JWT_EXPIRATION=24h

# APPLICATION
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
DEV_AUTH_BYPASS=false
DEV_FORCE_PRO=false

# Stripe Billing
#
# v1.0 launch pricing contract: FREE = $0, PRO = $24.99/month. There is no Expert tier.
# STRIPE_PRO_PRICE_ID is the ONLY price a v1.0 checkout may open. It must point at a
# recurring monthly $24.99 USD price. The price IDs recorded in
# verification/insite-billing-lifecycle-2026-08-17/ (Pro Monthly $6.99) predate this
# contract and MUST NOT be reused.
#
# PRODUCTION_STRIPE_PRICE_UPDATE_REQUIRED: a $24.99/month production price object does
# not exist yet and cannot be created from this repository. Create it in the Stripe
# dashboard/API and set STRIPE_PRO_PRICE_ID in the production environment before launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
#
# INTERNAL_LEGACY_COMPATIBILITY ONLY -- never customer-selectable.
# resolveTierForPriceId() reads these so that a subscription still billing on a retired
# Plus/Company/Expert price continues to resolve to Pro entitlements. Leave them unset
# unless such a subscription actually exists in the target environment. Nothing writes
# them into a new checkout session.
STRIPE_PLUS_PRICE_ID=
STRIPE_COMPANY_PRICE_ID=
STRIPE_EXPERT_PRICE_ID=
BILLING_SUCCESS_URL=http://localhost:3000/profile?billing=success
BILLING_CANCEL_URL=http://localhost:3000/pricing?billing=cancelled
