# §311A / BR-5 — TEMPLATE for the operator secret file. CONTAINS NO SECRETS.
#
# =====================================================================================================
# THIS FILE IS TRACKED. THE FILE YOU CREATE FROM IT IS NOT.
#
# The repository is PUBLIC (register entry SE-21), so no real value may ever be written here or
# anywhere else under version control. Copy it out of the repository, fill it in, and lock it down:
#
#   mkdir -p ~/.safety-insite && chmod 700 ~/.safety-insite
#   cp backend/scripts/ops/backup.env.example ~/.safety-insite/backup.env
#   chmod 600 ~/.safety-insite/backup.env
#   $EDITOR ~/.safety-insite/backup.env
#
# `run-scheduled-backup.sh` REFUSES to read this file unless its mode is 600 or 400, so a permissive
# copy fails the backup loudly instead of being used quietly.
#
# SINGLE-QUOTE EVERY VALUE. This file is SOURCED by bash, and a connection string contains `&` and
# `?`. Unquoted, bash treats `&` as "run in background" and the variable silently ends up empty or
# truncated — §311A's first scheduled run failed with "BACKUP_SOURCE_DATABASE_URL is not set" while
# the value was sitting in the file, plainly visible. Quote everything and the class of bug is gone.

# --- The database to back up -------------------------------------------------------------------
# Production's connection string. The pooler hostname is fine: the backup script rewrites it to the
# direct endpoint, which pg_dump requires for its snapshot connection.
BACKUP_SOURCE_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require'

# --- The dedicated backup destination ------------------------------------------------------------
# MUST NOT be the application's object bucket. The backup script refuses to start if
# BACKUP_S3_BUCKET equals STORAGE_S3_BUCKET, because a database dump is every customer at once and
# must not be readable by the credential that exists to serve one customer their own photo.
BACKUP_S3_ENDPOINT='https://<ACCOUNT_ID>.r2.cloudflarestorage.com'
BACKUP_S3_BUCKET='<dedicated-backup-bucket>'
BACKUP_S3_ACCESS_KEY_ID='<scoped-token-access-key-id>'
BACKUP_S3_SECRET_ACCESS_KEY='<scoped-token-secret>'
BACKUP_S3_REGION='auto'
BACKUP_S3_PREFIX='postgres'

# --- Retention. The accepted §311 contract. -------------------------------------------------------
BACKUP_RETAIN_DAILY='14'
BACKUP_RETAIN_WEEKLY='8'

# --- Binding the artifact to the build that was serving when it was taken -------------------------
BACKUP_VERSION_URL='https://safescope-backend.onrender.com/health/version'

# --- Failure signalling ---------------------------------------------------------------------------
# The EXISTING MO-1 channel. Same value as the production OPERATIONAL_ALERT_WEBHOOK_URL, so a backup
# failure lands where every other operational failure already lands. Optional but strongly wanted:
# without it, a failed backup is only an exit code nobody is watching.
OPERATIONAL_ALERT_WEBHOOK_URL='<the MO-1 webhook URL>'

# --- Freshness threshold --------------------------------------------------------------------------
# 36h on a daily schedule: one missed run is tolerated, two consecutive ones are not.
BACKUP_MAX_AGE_HOURS='36'

# --- Client resolution ----------------------------------------------------------------------------
# Optional. The scripts probe known locations and refuse any client older than the PostgreSQL 17
# server, so this is only needed if pg_dump lives somewhere unusual.
# BACKUP_PG_DUMP_PATH=/opt/homebrew/opt/libpq/bin/pg_dump
# BACKUP_PG_CLIENT_DIR=/opt/homebrew/opt/libpq/bin

# --- Local hygiene --------------------------------------------------------------------------------
# Leave unset. The default deletes the local artifact after a verified upload, because a backup
# strategy that lives on a laptop is not a backup strategy.
# BACKUP_KEEP_LOCAL=false
